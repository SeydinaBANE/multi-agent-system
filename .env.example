OPENROUTER_API_KEY=sk

# Brave Search (optionnel) — active la recherche web dans le Researcher
# Clé gratuite sur https://brave.com/search/api/
BRAVE_API_KEY=

# Pour le déploiement VPS (utilisé par docker-compose.prod.yml)
VPS_IP=

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/multiagent
REDIS_URL=redis://redis:6379/0
QDRANT_HOST=qdrant
QDRANT_PORT=6333

MODEL_FAST=mistralai/mistral-7b-instruct
MODEL_DEFAULT=openai/gpt-4o-mini
MODEL_SMART=openai/gpt-4o
