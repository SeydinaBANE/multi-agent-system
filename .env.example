# ── LLM ───────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...

# ── Auth API (optionnel — si absent, pas d'authentification) ──────────────────
# Générer avec : openssl rand -hex 32
# À définir aussi dans Vercel : NEXT_PUBLIC_API_KEY=même valeur
API_KEY=

# ── Brave Search (optionnel) ───────────────────────────────────────────────────
# Clé gratuite sur https://brave.com/search/api/
BRAVE_API_KEY=

# ── Base de données ────────────────────────────────────────────────────────────
# Dev local (Docker Compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/multiagent
# Prod Railway → remplacer par l'URL fournie dans le dashboard Railway
# DATABASE_URL=postgresql+asyncpg://postgres:xxx@xxx.railway.app:5432/railway

# ── Redis ──────────────────────────────────────────────────────────────────────
# Dev local
REDIS_URL=redis://redis:6379/0
# Prod Railway → remplacer par l'URL fournie dans le dashboard Railway
# REDIS_URL=redis://default:xxx@xxx.railway.app:6379

# ── Qdrant ─────────────────────────────────────────────────────────────────────
# Dev local (Docker Compose)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
# Prod Qdrant Cloud → décommenter et remplir
# QDRANT_HOST=xyz-abc-123.us-east4-0.gcp.cloud.qdrant.io
# QDRANT_PORT=6333
# QDRANT_API_KEY=your-qdrant-cloud-api-key

# ── Modèles LLM (via OpenRouter) ───────────────────────────────────────────────
MODEL_FAST=anthropic/claude-haiku-4-5
MODEL_DEFAULT=anthropic/claude-haiku-4-5
MODEL_SMART=anthropic/claude-haiku-4-5

# ── CORS ───────────────────────────────────────────────────────────────────────
# Dev local (défaut automatique)
# ALLOWED_ORIGINS=["http://localhost:3000"]
# Prod → remplacer par l'URL Vercel
# ALLOWED_ORIGINS=["https://ton-projet.vercel.app"]
